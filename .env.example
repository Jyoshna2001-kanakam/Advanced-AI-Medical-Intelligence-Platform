# Copy to .env and fill in real values. Never commit the real .env file.

# Required for real LLM-generated reports. Without this, the API falls back
# to a deterministic template report so the app still works end-to-end.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./medical_ai.db

# Model / storage paths
MODEL_PATH=models/pneumonia_densenet121.pth
GRADCAM_DIR=gradcam_outputs
